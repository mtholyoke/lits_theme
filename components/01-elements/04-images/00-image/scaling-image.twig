{#
/**
 * @file
 * Theme override to display a block.
 *
 * Available variables:
 * - plugin_id: The ID of the block implementation.
 * - label: The configured label of the block if visible.
 * - configuration: A list of the block's configuration values.
 *   - label: The configured label for the block.
 *   - label_display: The display settings for the label.
 *   - provider: The module or other provider that provided this block plugin.
 *   - Block plugin specific settings will also be stored here.
 * - content: The content of this block.
 * - attributes: array of HTML attributes populated by modules, intended to
 *   be added to the main container tag of this template.
 *   - id: A valid HTML ID and guaranteed unique.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @see template_preprocess_block()
 */
#}
{% if content.field_image %}
<div id="{{ attributes['id'] }}">
  <div class="scaling-image contain" {#{{attributes | without("id")}}#}>
  {% block content %}
  <div class="feature-container">
    <div class="feature">
      <div class="feature-image" style="background-image: url({{content.field_image[0]['#markup']}});"></div>
      {% if content.field_heading[0]['#text'] or content.field_heading_suffix[0]['#text'] %}
      <div class="feature-text">
        {# Ridiculous because I don't _want_ Drupal adding containers and p tags #}
        <h1>{{ content.field_heading[0]['#text'] }}{{ content.field_heading_suffix[0]['#text'] | raw }}</h1>
        <sub>{{ content.field_subtext }}</sub>
        {{ content.field_body }}

        {# Using link.twig here adds an id to the anchor tag that shouldn't be there and I couldn't get it to Go Away #}
        {% set ctaLink = content.field_link[0]['#url'] %}
        {% set ctaText = content.field_link[0]['#title'] %}
        {% set ctaClasses = create_attribute() %}
        {% set ctaClasses = ctaClasses.addClass("cta") %}
        {% set ctaAttributes = content.field_link[0]['#url'].getOption("attributes") %}
        {% if ctaAttributes.class is defined %}
          {% set ctaClasses = ctaClasses.addClass(ctaAttributes.class) %}
        {% endif %}
        <a{{ ctaClasses }}
          {% for attribute, value in ctaAttributes %}
            {% if attribute != "class" %}
              {{ attribute }}="{{- value -}}"
            {% endif %}
          {% endfor %}
          href="{{ ctaLink }}">{{ ctaText }}</a>



      </div>
      {% endif %}
    </div>
  </div>
  {% endblock %}
  </div>
</div>
{% endif %}
