{# {#
/**
 * @file
 * Theme override for the content of a service desk or study space page.
 *
 * This template is meant to be used as an embed to provide page content
 * for the templates referenced below:
 *
 * @see templates/content/node--study-space--full.html.twig
 * @see templates/views/views-view-fields--about-lits-service-desks--detail-page.html.twig
 */
#}


<article class="lits-location {{ original_type }}">
  <div class="layout-container">
      <hgroup class="service-desk-header">
        <h1 class="service-desk-title">{{ fields.name.content }}</h1>
        <p class="service-desk-tagline">{{ fields.field_slogan.content }}</p> <!-- styling this right w/o a wrapping element woudl be ridiculous -->
      </hgroup>
<div class="service-desk-banner">
      <div class="location-images">
        {% block location_images %}
        {% endblock location_images %}
      </div>
      <div class="location-teaser-bite">
        <div class="location-teaser">
          {% block location_teaser %}
          {% endblock location_teaser %}
        </div>
      </div>
</div>
  


<div class="main-content-service-desk">
	<!--new wrapper, could just flex entire page but that would be annoying-->
	<div class="location-sidebar"> 
    <div class="location-sidebar-menu">
      {% block location_sidebar %}
      {% endblock location_sidebar %}
    </div>
  </div>
  <div class="location-content">
    <div class="location-bite"> 
      {% block location_bite %}
      {% endblock location_bite %}
    </div>
      {% block location_content %}
      {% endblock location_content %}
    <div class="location-hours"> 
      {% block location_hours %}
      {% endblock location_hours %}
    </div>

{% if service_desk_page %}
    <h2>Need assistance?</h2>
    <ul>
      <li>Email us at
        <a href="mailto:{{ fields.field_email.content }}">{{ fields.field_email.content }}</a>
      </li>
      <li>Call us at
        {{ fields.field_phone_number.content|striptags|trim }}.</li>
      {# <li>Write us at {{ fields.name.content }}, Mount Holyoke College, 50 College Street, 8 Dwight Hall, South Hadley, MA 01075.</li> #}
      <li>Write us at
        {{ fields.name.content|striptags|trim }}, Mount Holyoke College, 50 College Street, South Hadley, MA 01075.</li>
    </ul>
    {% endif  %}
  </div>
</div>


  </div>
</article>
