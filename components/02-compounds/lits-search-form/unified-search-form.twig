{#
/**
 * @file
 * Theme override for the LITS unified search form
 *
 * @see templates/block/block.html.twig
 * @see template_preprocess_block()
 */
#}

{# TODO wtf with the ids #}
{{ attach_library('lits_search/unified_search') }}

<div {{ attributes.addClass("layout-zone") }}>
  {{ title_prefix }}
  {% if label %}
    <h2 class="block-title" {{ title_attributes.addClass('h2') }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}

  {% block content %}
  <div class="tabs">
    <div role="tablist" aria-label="Search" class="tablist">
    {% for form in content %}
    <details id="tab-{{loop.index0}}"  {% if loop.index0 == 0 %} open {% endif %}>
      <summary  id="tabcontrol-{{loop.index0}}" class="panel-control">{{ form['title'] }}</summary>

      <div id="tabpanel-{{loop.index0}}" role="tabpanel" aria-labelledby="tabcontrol-{{loop.index0}}" class="panel-content">
        {{ form['form'] }}
      </div>
    </details>
    {% endfor %}

  </div>

  {% endblock %}</div>

</div>
