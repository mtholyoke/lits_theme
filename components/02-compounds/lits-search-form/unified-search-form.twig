{#
/**
 * @file
 * Theme override for the LITS unified search form
 *
 * @see templates/block/block.html.twig
 * @see template_preprocess_block()
 */
#}

{{ attach_library('lits_search/unified_search') }}
{% block content %}
<div {{ attributes.addClass("search") }}>
	<h2 class="search-heading">Search and Discover</h2>
	<div class="pe">

    {% for form in content %}
      <h1 class="pe-control{% if loop.index0 == open_tab %} active{% endif %}" id="pe-control-{{loop.index0}}" data-controls="content-{{loop.index0}}">
        <button>{{ form['title'] | raw }}</button>
      </h1>
      <div id="content-{{loop.index0}}" class="pe-content{% if loop.index0 == open_tab %} active{% endif %}" style="{% if loop.index0 != open_tab %}display:none;{% endif %}">
        {{ form['form'] }}
      </div>
    {% endfor %}
	</div>
</div>
{% endblock %}
